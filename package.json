{
  "name": "ff-mcp-bridge-root",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension + local MCP server so an MCP client can control Firefox",
  "license": "MIT",
  "workspaces": ["server"],
  "scripts": {
    "start": "node server/src/index.js",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "lint:ext": "npx --yes web-ext lint --source-dir extension",
    "run:ext": "npx --yes web-ext run --source-dir extension --firefox-profile ff-mcp-dev --keep-profile-changes"
  }
}
